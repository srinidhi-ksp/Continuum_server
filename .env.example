# Copy to .env in this same folder (Continuum_server/) and fill in real values.
# Never commit the real .env.

# Supabase project settings > API
SUPABASE_URL=https://your-project-ref.supabase.co

# Settings > API > service_role key — NOT the anon key. This key bypasses
# Row Level Security, which is exactly why it must only ever live here on
# the server, never in the React app's .env, never in a VITE_ variable,
# never in anything that ships to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated origins allowed to call this API. The Vite dev server
# default is 5173 — add your deployed frontend URL here too once you have one.
FRONTEND_ORIGINS=http://localhost:5173

# Add your Gemini API key for the AI Assistant
GEMINI_API_KEY=your_gemini_api_key_here
